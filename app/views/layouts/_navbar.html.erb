<header class="navbar bg-base-100 shadow">
  <div class="navbar-start">
    <%= link_to (user_signed_in? ? root_path : new_user_session_path),
                class: "btn btn-ghost px-2 gap-2 items-center text-primary" do %>
      <%= render "shared/bankencore_logo_horizontal" %>
      <span class="sr-only">BankEncore</span>
    <% end %>
  </div>

  <div class="navbar-center">
    <form action="#" method="get" class="join">
      <input name="q" class="input input-bordered join-item w-64" placeholder="Search"/>
      <button class="btn btn-primary join-item" type="submit">Search</button>
    </form>
  </div>

  <!-- Right: Admin + User -->
  <!-- app/views/layouts/_navbar.html.erb -->
  <div class="navbar-end gap-3">
    <% if defined?(policy) && policy(:admin_dashboard).index? %>
      <%= link_to "Admin", admin_root_path, class: "btn btn-ghost" %>
    <% end %>
    <%= render "layouts/user_menu" %>
  </div>
  <% content_for :page_scripts do %>
    <%= render "layouts/theme_switcher_script" %>
  <% end %>

</div>
  </div>
</header>
