<header class="navbar bg-base-100 shadow">
  <div class="flex-1">
    <%= link_to (user_signed_in? ? root_path : new_user_session_path),
                class: "btn btn-ghost text-xl gap-2" do %>
      <!-- If your SVG uses currentColor, set the wrapper color -->
      <span class="inline-flex items-center gap-2 text-primary
                   [&>span>svg]:h-7 [&>span>svg]:w-7">
        <%= app_logo %>
        <span class="hidden sm:inline font-semibold leading-none">BankEncore</span>
      </span>
      <span class="sr-only">BankEncore</span>
    <% end %>
  </div>

  <div class="flex-none flex items-center gap-3">

    <%# Pundit %>
    <% if policy(:admin_dashboard).index? %>
      <%= link_to "Admin", admin_root_path %>
    <% end %>


    <%# CanCanCan
    <%# if defined?(can?) && can?(:read, :admin_dashboard) %>
    <%#   = link_to "Admin", admin_root_path, class: "btn btn-ghost" %>
    <%# end %>

    <%# Simple helper fallback
    <%# if respond_to?(:can_access_admin?) && can_access_admin? %>
    <%#   = link_to "Admin", admin_root_path, class: "btn btn-ghost" %>
    <%# end %>

    <% if user_signed_in? %>
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
          <div class="w-10 rounded-full bg-neutral text-neutral-content grid place-items-center">
            <span class="font-bold"><%= current_user.email.first.upcase %></span>
          </div>
        </div>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-56">
          <li><%= link_to "Profile", "/profile" %></li>
          <li><%= link_to "Settings", "/settings" %></li>
          <li>
            <%= button_to "Sign out", destroy_user_session_path,
                  method: :delete,
                  form: { class: "contents" },
                  class: "justify-start w-full text-left" %>
          </li>
          <li><%= render "layouts/theme_switcher" %></li>
        </ul>
      </div>
    <% else %>
      <%= link_to "Sign in", new_user_session_path, class: "btn btn-ghost" %>
    <% end %>
  </div>
</header>
