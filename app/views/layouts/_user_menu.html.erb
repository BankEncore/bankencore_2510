<!-- app/views/layouts/_user_menu.html.erb -->
<div class="dropdown dropdown-end">
  <button tabindex="0" class="btn btn-ghost btn-circle avatar" aria-label="User menu">
    <div class="w-10 rounded-full bg-neutral text-neutral-content grid place-items-center">
      <span class="font-bold"><%= current_user&.email&.first&.upcase || "?" %></span>
    </div>
  </button>

  <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[2] p-2 shadow bg-base-100 rounded-box w-64">
    <li class="menu-title"><span>Account</span></li>
    <% if user_signed_in? %>
      <li><%= link_to "Profile", "/profile" %></li>
      <li><%= link_to "Settings", "/settings" %></li>
        <li>
        <%= link_to "Sign out",
                destroy_user_session_path,
                data: { turbo_method: :delete, turbo_confirm: "Sign out?" } %>
        </li>
    <% else %>
      <li><%= link_to "Sign in", new_user_session_path %></li>
    <% end %>

    <li><hr class="my-2"></li>

    <li class="menu-title"><span>Theme</span></li>
    <li>
      <details>
        <summary>Customize</summary>
        <div class="p-3 space-y-3">
          <div class="form-control">
            <span class="label-text mb-1">Palette</span>
            <label class="label cursor-pointer justify-start gap-2">
              <input type="radio" name="be-palette" value="cool" class="radio radio-xs be-theme__palette">
              <span>Encore Cool</span>
            </label>
            <label class="label cursor-pointer justify-start gap-2">
              <input type="radio" name="be-palette" value="warm" class="radio radio-xs be-theme__palette">
              <span>Encore Warm</span>
            </label>
          </div>

          <div class="form-control">
            <label class="label cursor-pointer justify-between">
              <span class="label-text">Dark mode</span>
              <input type="checkbox" class="toggle be-theme__mode">
            </label>
          </div>

          <input type="radio" name="theme" class="theme-controller hidden be-theme__controller" value="encoreCool">
        </div>
      </details>
    </li>
  </ul>
</div>
