<!-- app/views/payments/ach_routings/show.html.erb -->
<div class="max-w-5xl mx-auto p-4 space-y-4">
  <!-- Header -->
  <div class="flex items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold"><%= @ach_routing.customer_name %></h1>

    <div class="mt-1 flex flex-wrap items-center gap-2 text-sm">
      <span class="badge badge-outline font-mono">RTN <%= @ach_routing.routing_number %></span>
      <% if @ach_routing.routing_changed? %>
        <span class="badge badge-warning badge-sm ml-1">Changed</span>
      <% end %>
      <% if (b = @ach_routing.frb_branch) %>
        <span class="badge badge-info">FRB: <%= b.city %></span>
      <% end %>
    </div>

    <div class="flex gap-2">
      <%= link_to "Back",
                  payments_ach_routings_path(request.query_parameters.except(:controller, :action, :public_id)),
                  class: "btn btn-ghost" %>

  <% if current_user&.system_admin? %>
        <%= link_to "Edit",
                    edit_admin_payments_ach_routing_path(@ach_routing),
                    class: "btn btn-primary" %>
      <% end %>

      <%= link_to "All Routings", payments_ach_routings_path, class: "btn" %>
    </div>
  </div>

  <!-- Contact -->
  <div class="grid md:grid-cols-2 gap-4">
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title">Contact</h2>
        <div class="text-sm space-y-1">
          <div><%= @ach_routing.address %></div>
          <div><%= @ach_routing.city %>, <%= @ach_routing.state_code %> <%= @ach_routing.zip_code %></div>
          <% if @ach_routing.phone_number.present? %>
            <div class="flex items-center gap-2">
              <span class="opacity-70">Phone</span>
              <span class="font-mono"><%= number_to_phone(@ach_routing.phone_number) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Flags and Notes -->
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title">Flags & Notes</h2>
        <div class="flex flex-wrap gap-2">
          <% @ach_routing.flags.each do |label, klass| %>
            <span class="badge <%= klass %>"><%= label %></span>
          <% end %>
          <% if @ach_routing.flags.empty? %>
            <span class="opacity-70 text-sm">No special flags</span>
          <% end %>
        </div>

        <% if @ach_routing.respond_to?(:notes) && @ach_routing.notes.present? %>
          <div class="mt-3">
            <div class="opacity-70 text-sm mb-1">Notes</div>
            <div class="prose max-w-none text-sm whitespace-pre-wrap"><%= simple_format(h(@ach_routing.notes)) %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- FRB details -->
  <%= render "frb_details", routing: @ach_routing %>
  
  <!-- Raw record -->
  <details class="collapse bg-base-200">
    <summary class="collapse-title text-sm">Raw record</summary>
    <div class="collapse-content">
      <pre class="text-xs overflow-x-auto"><%= JSON.pretty_generate(@ach_routing.attributes) %></pre>
    </div>
  </details>
</div>
