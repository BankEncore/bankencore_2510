<%# app/views/shared/reference_lists/_summary.html.erb %>
<%# locals: list: System::ReferenceList, show_api: true/false (default true) %>
<% list ||= local_assigns.fetch(:list) %>
<% show_api = local_assigns.fetch(:show_api, true) %>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <h2 class="card-title"><%= list.name %></h2>
    <p class="text-sm">
      <span class="font-medium">Key:</span> <code><%= list.key %></code>
      · <span class="font-medium">Visibility:</span> <%= list.visibility %>
      <% if list.schema_version.present? %> · <span class="font-medium">Schema:</span> <%= list.schema_version %><% end %>
    </p>

    <div class="text-sm">
      <span class="font-medium">Public ID:</span> <code><%= list.public_id %></code>
    </div>

    <div class="text-sm">
      <span class="font-medium">Tags:</span>
      <% if list.tags.present? %>
        <% list.tags.each { |t| concat content_tag(:span, t, class: "badge badge-outline mr-1") } %>
      <% else %>
        —
      <% end %>
    </div>

    <div class="text-sm">
      <span class="font-medium">Description:</span>
      <%= list.description.presence || "—" %>
    </div>

    <div class="opacity-70 text-xs">
      Created <%= time_ago_in_words(list.created_at) %> ago · Updated <%= time_ago_in_words(list.updated_at) %> ago
    </div>

    <% if show_api %>
      <div class="mt-3">
        <p class="text-sm font-medium mb-1">Public API</p>
        <pre class="text-xs bg-base-200 p-3 rounded"><code>/system/reference_lists/<%= list.public_id %></code></pre>
        <pre class="text-xs bg-base-200 p-3 rounded"><code>/system/reference_lists/<%= list.public_id %>/reference_values</code></pre>
      </div>
    <% end %>
  </div>
</div>
