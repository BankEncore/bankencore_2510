<%# app/views/admin/payments/ach_routings/edit.html.erb %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">
    Edit <span class="font-mono"><%= @ach_routing.routing_number %></span>
  </h1>
  <div class="flex gap-2">
    <%= link_to "View", polymorphic_path([:admin, @ach_routing]), class: "btn btn-ghost" %>
    <%= link_to "Back", admin_payments_ach_routings_path, class: "btn" %>
  </div>
</div>

<%= render "admin/payments/ach_routings/form",
           ach_routing: @ach_routing,
           ns: :admin,
           frb_options: @frb_options %>
