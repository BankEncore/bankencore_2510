<%# app/views/admin/system/reference_values/index.html.erb %>
<h1 class="text-xl font-semibold">Reference Values — <%= @list.key %></h1>

<div class="mb-3">
  <%= link_to "New Value",
      new_admin_system_reference_list_reference_value_path(@list),
      class: "btn btn-primary btn-sm" %>
  <%= link_to "Back to list",
      admin_system_reference_list_path(@list, format: nil),
      class: "btn btn-ghost btn-sm ml-2" %>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Pos</th>
            <th>Code</th>
            <th>Name</th>
            <th>Active</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @values.any? %>
            <% @values.each do |v| %>
              <tr>
                <td><%= v.sort_index %></td>
                <td class="font-mono"><%= v.code.presence || "—" %></td>
                <td><%= v.name %></td>
                <td><%= v.active ? "yes" : "no" %></td>
                <td class="text-right whitespace-nowrap">
                  <%= link_to "Show",
                      admin_system_reference_list_reference_value_path(@list, v),
                      class: "link link-primary mr-2" %>
                  <%= link_to "Edit",
                      edit_admin_system_reference_list_reference_value_path(@list, v),
                      class: "link mr-2" %>
                  <%= link_to "Delete",
                      admin_system_reference_list_reference_value_path(@list, v),
                      data: { turbo_method: :delete, turbo_confirm: "Delete this value?" },
                      class: "link link-error" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="5" class="text-center opacity-70">No values.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
