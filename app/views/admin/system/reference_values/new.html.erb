<%# app/views/admin/system/reference_values/new.html.erb %>
<h1 class="text-xl font-semibold">New Reference Value</h1>

<div class="mt-4">
  <%= link_to "Back to list values",
              admin_system_reference_list_reference_values_path(@list),
              class: "link" %>
  <%= link_to "Back to list",
              admin_system_reference_list_path(@list),
              class: "link ml-4" %>
</div>

<div class="card bg-base-100 shadow mt-4">
  <div class="card-body">
    <%= render "form", list: @list, value: @value %>
  </div>
</div>
