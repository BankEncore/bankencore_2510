<%# app/views/admin/system/reference_values/_form.html.erb %>
<% action_url =
     value.persisted? ?
       admin_system_reference_list_reference_value_path(list, value) :
       admin_system_reference_list_reference_values_path(list)
%>
<% http_method = value.persisted? ? :patch : :post %>

<%= form_with model: value, url: action_url, method: http_method, local: true do |f| %>
  <div class="grid gap-4 md:grid-cols-2">
    <div><%= f.label :code %><%= f.text_field :code, class: "input input-bordered w-full" %></div>
    <div><%= f.label :name %><%= f.text_field :name, class: "input input-bordered w-full" %></div>
    <div><%= f.label :short_name %><%= f.text_field :short_name, class: "input input-bordered w-full" %></div>
    <div><%= f.label :sort_index %><%= f.number_field :sort_index, class: "input input-bordered w-full" %></div>
    <div class="flex items-center gap-2 mt-6"><%= f.check_box :active %><%= f.label :active %></div>
  </div>

  <div class="mt-4"><%= f.label :description %><%= f.text_area :description, rows: 3, class: "textarea textarea-bordered w-full" %></div>

  <div class="mt-6">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_system_reference_list_reference_values_path(list), class: "btn btn-ghost ml-2" %>
  </div>
<% end %>
