<%# locals: list (optional). Defaults to @list %>
<% list ||= @list %>

<%= form_with model: list, url: (list.persisted? ? admin_system_reference_list_path(list) : admin_system_reference_lists_path), class: "space-y-4" do |f| %>
  <% if list.errors.any? %>
    <div class="alert alert-error">
      <strong><%= pluralize(list.errors.count, "error") %> prevented saving:</strong>
      <ul class="list-disc ml-6">
        <% list.errors.full_messages.each { |m| concat content_tag(:li, m) } %>
      </ul>
    </div>
  <% end %>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, class: "input input-bordered w-full", required: true %>
    </div>

    <div>
      <%= f.label :key, class: "label" %>
      <%= f.text_field :key, class: "input input-bordered w-full font-mono", placeholder: "parties.identity_types", required: true %>
      <p class="text-xs opacity-70 mt-1">Namespaced machine key. Unique.</p>
    </div>

    <div>
      <%= f.label :visibility, class: "label" %>
      <%= f.select :visibility, [%w[public public], %w[internal internal], %w[private private]],
                   {}, class: "select select-bordered w-full" %>
    </div>

    <div>
      <%= f.label :schema_version, class: "label" %>
      <%= f.text_field :schema_version, class: "input input-bordered w-full", placeholder: "v1.0" %>
      <p class="text-xs opacity-70 mt-1">Bump when value metadata contract changes.</p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :tags, class: "label" %>
      <%= f.text_field :tags, value: Array(list.tags).join(", "),
                       class: "input input-bordered w-full",
                       data: { controller: "comma-tags" } %>
      <p class="text-xs opacity-70 mt-1">Comma-separated tags. Stored as array.</p>
    </div>

    <div class="md:col-span-2">
      <%= f.label :description, class: "label" %>
      <%= f.text_area :description, rows: 3, class: "textarea textarea-bordered w-full" %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit(class: "btn btn-primary") %>
    <% if list.persisted? %>
      <%= link_to "Cancel", admin_system_reference_list_path(list), class: "btn btn-ghost" %>
    <% else %>
      <%= link_to "Cancel", admin_system_reference_lists_path, class: "btn btn-ghost" %>
    <% end %>
  </div>
<% end %>
