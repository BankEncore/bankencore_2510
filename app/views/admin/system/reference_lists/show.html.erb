<!-- app/views/admin/system/reference_lists/show.html.erb -->
<nav class="breadcrumbs text-sm mb-4">
  <ul>
    <li><%= link_to "Admin", admin_root_path, class: "badge badge-ghost" %></li>
    <li><%= link_to "Reference Lists", admin_system_reference_lists_path, class: "badge badge-ghost" %></li>
    <li><span class="badge badge-primary"><%= @list.key %></span></li>
  </ul>
</nav>

<div class="flex gap-2 mb-4">
  <%= link_to "Edit", edit_admin_system_reference_list_path(@list), class: "btn btn-primary btn-sm" %>
  <%= link_to "New Value", new_admin_system_reference_list_reference_value_path(@list), class: "btn btn-secondary btn-sm" %>
  <%= link_to "Delete",
              admin_system_reference_list_path(@list),
              data: { turbo_method: :delete, turbo_confirm: "Delete this list? Values are FK-protected." },
              class: "btn btn-error btn-outline btn-sm" %>
  <%= link_to "Back", admin_system_reference_lists_path, class: "btn btn-ghost btn-sm" %>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body space-y-2">
    <h2 class="card-title">Details</h2>
    <div><span class="font-semibold">Name:</span> <%= @list.name %></div>
    <div><span class="font-semibold">Key:</span> <span class="font-mono"><%= @list.key %></span></div>
    <div><span class="font-semibold">Active:</span> <%= @list.active ? "yes" : "no" %></div>
    <div><span class="font-semibold">Description:</span><br><%= simple_format(@list.description) %></div>
    <div class="text-xs opacity-70">
      Created <%= @list.created_at&.to_fs(:db) %> · Updated <%= @list.updated_at&.to_fs(:db) %>
    </div>
  </div>
</div>

<div class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <div class="flex items-center justify-between">
      <h2 class="card-title">Values (<%= @list.reference_values.count %>)</h2>
      <%= link_to "New Value", new_admin_system_reference_list_reference_value_path(@list), class: "btn btn-secondary btn-sm" %>
    </div>

    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Pos</th>
            <th>Code</th>
            <th>Key</th>
            <th>Label</th>
            <th>Active</th>
            <th>Effective</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @list.reference_values.ordered.each do |v| %>
            <tr>
              <td class="whitespace-nowrap"><%= v.sort_index %></td>
              <td class="font-mono"><%= v.code.presence || "—" %></td>
              <td><%= v.name %></td>
              <td><%= v.active ? "yes" : "no" %></td>
              <td class="text-xs"><%= v.valid_from&.to_s || "—" %> → <%= v.valid_to&.to_s || "—" %></td>
              <td class="text-right whitespace-nowrap">
                <%= link_to "Show",
                            admin_system_reference_list_reference_value_path(@list, v),
                            class: "link link-primary mr-2" %>
                <%= link_to "Edit",
                            edit_admin_system_reference_list_reference_value_path(@list, v),
                            class: "link mr-2" %>
                <%= link_to "Delete",
                            admin_system_reference_list_reference_value_path(@list, v),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this value?" },
                            class: "link link-error" %>
              </td>
            </tr>
          <% end %>
          <% if @list.reference_values.empty? %>
            <tr><td colspan="7" class="text-center opacity-70">No values yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
