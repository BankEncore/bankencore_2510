<!-- app/views/admin/system/reference_lists/index.html.erb -->
<div class="flex items-center justify-between mb-4">
  <h1 class="text-xl font-semibold">Reference Lists</h1>
  <%= link_to "New List", new_admin_system_reference_list_path, class: "btn btn-primary btn-sm" %>
</div>

<div class="card bg-base-100 shadow">
  <div class="card-body">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Name</th>
            <th>Key</th>
            <th>Active</th>
            <th class="w-40 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @lists.each do |list| %>
            <tr>
              <td><%= list.name %></td>
              <td class="font-mono"><%= list.key %></td>
              <td><%= list.active ? "yes" : "no" %></td>
              <td class="text-right">
                <%= link_to "Show", admin_system_reference_list_path(list), class: "link link-primary mr-2" %>
                <%= link_to "Edit", edit_admin_system_reference_list_path(list), class: "link mr-2" %>
                <%= link_to "Delete",
                            admin_system_reference_list_path(list),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this list? Values are FK-protected." },
                            class: "link link-error" %>
              </td>
            </tr>
          <% end %>
          <% if @lists.empty? %>
            <tr><td colspan="4" class="text-center opacity-70">No lists.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
