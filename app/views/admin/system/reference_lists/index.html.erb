<%# app/views/admin/system/reference_lists/index.html.erb %>

<%# Header + actions %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-xl font-semibold">Reference Lists</h1>
  <%= link_to "New List", new_admin_system_reference_list_path, class: "btn btn-primary btn-sm" %>
</div>

<%# Filters (optional simple q on key/name) %>
<div class="mb-4">
  <%= form_with url: admin_system_reference_lists_path, method: :get, local: true, class: "flex gap-2" do %>
    <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search key or name" class="input input-bordered w-full md:w-80">
    <%= submit_tag "Search", class: "btn btn-outline btn-sm" %>
  <% end %>
</div>

<%# Table %>
<div class="card bg-base-100 shadow">
  <div class="card-body">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th class="w-40">Public ID</th>
            <th>Name</th>
            <th>Key</th>
            <th>Visibility</th>
            <th>Schema</th>
            <th>Tags</th>
            <th class="w-40 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @lists.each do |list| %>
            <tr>
              <td class="font-mono text-xs"><%= list.public_id %></td>
              <td><%= list.name %></td>
              <td class="font-mono"><%= list.key %></td>
              <td><%= list.visibility %></td>
              <td class="text-xs"><%= list.schema_version.presence || "—" %></td>
              <td class="text-xs">
                <% if list.tags.present? %>
                  <% list.tags.each { |t| concat content_tag(:span, t, class: "badge badge-outline mr-1") } %>
                <% else %>—<% end %>
              </td>
              <td class="text-right">
                <%= link_to "Show", admin_system_reference_list_path(list), class: "link link-primary mr-2" %>
                <%= link_to "Edit", edit_admin_system_reference_list_path(list), class: "link mr-2" %>
                <%= link_to "Delete",
                            admin_system_reference_list_path(list),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this list? Values are protected by FK." },
                            class: "link link-error" %>
              </td>
            </tr>
          <% end %>
          <% if @lists.empty? %>
            <tr><td colspan="7" class="text-center opacity-70">No lists.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
