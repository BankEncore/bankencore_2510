<h1>Admin · Users</h1>

<p><%= link_to "New User", new_admin_user_path %></p>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Name</th>
      <th>Admin</th>
      <th>Role</th>
      <th>Status</th>
      <th>Branches</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |u| %>
      <tr>
        <td><%= link_to u.email, [:admin, u] %></td>
        <td><%= u.name %></td>
        <td><%= u.admin? %></td>
        <td><%= u.respond_to?(:role_i) ? u.role_i : u.role %></td>
        <td><%= u.status %></td>
        <td><%= u.branches.order(:code).pluck(:code).join(", ") %></td>
        <td>
          <%= link_to "Edit", edit_admin_user_path(u) %> |
          <%= link_to "Delete", [:admin, u],
                data: { turbo_method: :delete, turbo_confirm: "Delete #{u.email}?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
