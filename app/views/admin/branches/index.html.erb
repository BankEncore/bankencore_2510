<!-- app/views/admin/branches/index.html.erb -->
<h1 class="text-xl font-semibold mb-4">Admin · Branches</h1>
<p class="mb-2"><%= link_to "New Branch", new_admin_branch_path, class: "btn btn-primary btn-sm" %></p>
<table class="table">
  <thead><tr><th>Code</th><th>Name</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% @branches.each do |b| %>
      <tr>
        <td><%= b.code %></td><td><%= b.name %></td><td><%= b.status %></td>
        <td class="text-right">
          <%= link_to "Show", [:admin, b], class: "btn btn-ghost btn-xs" %>
          <%= link_to "Edit", edit_admin_branch_path(b), class: "btn btn-ghost btn-xs" %>
          <%= link_to "Delete", [:admin, b], data: { turbo_method: :delete, turbo_confirm: "Delete #{b.code}?" }, class: "btn btn-ghost btn-xs text-error" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>