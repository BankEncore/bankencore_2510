<%# locals: f: %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="md:col-span-1">
    <label class="label">Residence Country</label>
    <%= f.text_field :residence_country, class: "input input-bordered w-full", placeholder: "US" %>
  </div>

  <div class="md:col-span-1">
    <label class="label">Birth Date</label>
    <%= f.date_field :birth_date, class: "input input-bordered w-full" %>
  </div>

  <div class="md:col-span-1">
    <label class="label">Gender</label>
    <%= f.select :gender_code, Ref.options("parties.gender"),
          { include_blank: true },
          class: "select select-bordered w-full" %>
  </div>

  <div class="md:col-span-1">
    <label class="label">Marital Status</label>
    <%= f.select :marital_status_code, Ref.options("parties.marital_status"),
          { include_blank: true },
          class: "select select-bordered w-full" %>
  </div>

  <div class="md:col-span-2">
    <label class="label">Education Level</label>
    <%= f.select :education_level_code, Ref.options("parties.education_level"),
          { include_blank: true },
          class: "select select-bordered w-full" %>
  </div>
</div>
