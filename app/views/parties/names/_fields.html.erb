<%# locals: f:, party: %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="md:col-span-1">
    <label class="label">Type</label>
    <%= f.select :name_type_code,
          Ref.options("parties.name_type"),
          { include_blank: false },
          class: "select select-bordered w-full" %>
  </div>

  <% if party.person? %>
    <div class="md:col-span-1">
      <label class="label">Family Name</label>
      <%= f.text_field :family_name, class: "input input-bordered w-full" %>
    </div>

    <div class="md:col-span-1">
      <label class="label">Given Name</label>
      <%= f.text_field :given_name, class: "input input-bordered w-full" %>
    </div>

    <div class="md:col-span-1">
      <label class="label">Middle Name</label>
      <%= f.text_field :middle_name, class: "input input-bordered w-full" %>
    </div>

    <div class="md:col-span-1">
      <label class="label">Prefix</label>
      <%= f.text_field :prefix_code, class: "input input-bordered w-full" %>
    </div>

    <div class="md:col-span-1">
      <label class="label">Suffix</label>
      <%= f.text_field :suffix_code, class: "input input-bordered w-full" %>
    </div>

    <div class="md:col-span-3">
      <label class="label">Full Name (derived)</label>
      <%= f.text_field :full_name, class: "input input-bordered w-full", readonly: true %>
    </div>
  <% else %>
    <div class="md:col-span-3">
      <label class="label">Full Legal Name</label>
      <%= f.text_field :full_name, class: "input input-bordered w-full" %>
    </div>
  <% end %>

  <%= f.hidden_field :preferred, value: true %>
</div>
