<!-- app/views/system/naics_codes/show.html.erb -->

<!-- Breadcrumbs -->
<nav class="breadcrumbs text-sm mb-4">
  <ul>
    <li>
      <%= link_to "NAICS #{@naics.version}",
                  system_naics_version_path(version: @naics.version),
                  class: "badge badge-ghost" %>
    </li>
    <% Array(@ancestors).each do |a| %>
      <li>
        <%= link_to a.code,
                    system_naics_code_path(version: a.version, code: a.code),
                    class: "badge badge-outline" %>
      </li>
    <% end %>
    <li><span class="badge badge-primary"><%= @naics.code %></span></li>
  </ul>
</nav>

<!-- Header -->
<header class="bg-base-200 p-4 rounded-lg mb-4 flex items-center justify-between gap-3">
  <div class="truncate">
    <h1 class="text-2xl font-bold">
      <span><%= @naics.code %></span>
      <span class="opacity-70">•</span>
      <span class="font-normal not-italic"><%= @naics.title %></span>
    </h1>
    <p class="text-sm opacity-70 mt-1">Version <%= @naics.version %></p>
  </div>
  <div class="shrink-0 space-x-2">
    <% if current_user&.system_admin? && main_app.respond_to?(:edit_admin_system_naics_code_path) %>
      <%= link_to "Edit",
                  main_app.edit_admin_system_naics_code_path(version: @naics.version, code: @naics.code),
                  class: "btn btn-sm" %>
    <% end %>
    <%= link_to "Back",
                system_naics_version_path(version: @naics.version),
                class: "btn btn-ghost btn-sm" %>
  </div>
</header>

<!-- Summary cards -->
<section class="grid md:grid-cols-2 gap-4 mb-6">
  <!-- Metadata -->
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body p-4">
      <h3 class="card-title text-sm mb-2">Metadata</h3>
      <dl class="text-sm grid grid-cols-3 gap-y-2">
        <dt class="opacity-60 col-span-1">Code</dt>
        <dd class="col-span-2 font-mono"><%= @naics.code %></dd>

        <dt class="opacity-60 col-span-1">Title</dt>
        <dd class="col-span-2"><%= @naics.title %></dd>

        <dt class="opacity-60 col-span-1">Version</dt>
        <dd class="col-span-2"><%= @naics.version %></dd>

        <dt class="opacity-60 col-span-1">Parent</dt>
        <dd class="col-span-2">
          <% if @parent %>
            <%= link_to "#{@parent.code}: #{@parent.title}",
                        system_naics_code_path(version: @parent.version, code: @parent.code),
                        class: "link" %>
          <% else %>-<% end %>
        </dd>

        <dt class="opacity-60 col-span-1">Sector</dt>
        <dd class="col-span-2"><span class="badge badge-outline"><%= @naics.sector %></span></dd>

        <dt class="opacity-60 col-span-1">Level</dt>
        <dd class="col-span-2"><span class="badge"><%= @naics.level %></span></dd>

        <dt class="opacity-60 col-span-1">Status</dt>
        <dd class="col-span-2">
          <%= @naics.respond_to?(:active) ? (@naics.active ? "Active" : "Inactive") : "-" %>
        </dd>
      </dl>
    </div>
  </div>

  <!-- Lineage -->
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body p-4">
      <h3 class="card-title text-sm mb-2">Lineage</h3>
      <p class="mb-2 text-sm opacity-70">Level <%= @naics.level %></p>
      <ol class="list-decimal pl-5 space-y-1 text-sm">
        <% Array(@lineage).each do |n| %>
          <li>
            <span class="font-mono">
              <%= link_to n.code,
                          system_naics_code_path(version: n.version, code: n.code),
                          class: "link" %>
            </span>
            <span class="opacity-60">—</span>
            <span><%= n.title %></span>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</section>

<!-- Tabs -->
<div class="tabs tabs-boxed mb-4">
  <a href="#description" class="tab tab-sm tab-active">Description</a>
  <a href="#hierarchy"   class="tab tab-sm">Hierarchy</a>
</div>

<!-- Description -->
<section id="description" class="prose max-w-none bg-base-100 p-6 rounded-lg shadow-sm mb-6">
  <h3>Description</h3>
  <%= @naics.description.present? ? simple_format(@naics.description) : content_tag(:p, "No description.") %>
</section>

<!-- Hierarchy tree -->
<section id="hierarchy" class="card bg-base-100 shadow-sm">
  <div class="card-body p-4">
    <h3 class="card-title text-sm mb-2">Hierarchy</h3>
    <ul class="menu menu-sm bg-base-100 rounded-box">
      <%= render partial: "node", locals: { node: @naics } %>
    </ul>
  </div>
</section>
