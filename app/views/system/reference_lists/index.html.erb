<%# app/views/system/reference_values/index.html.erb %>
<%# If nested under a list: params[:reference_list_public_id] will be present and @list is loaded in controller. %>

<h1 class="text-xl font-semibold mb-4">
  Reference Values<%= @list ? " · #{h @list.key}" : "" %>
</h1>

<div class="card bg-base-100 shadow">
  <div class="card-body p-0">
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Pos</th>
            <th>Code</th>
            <th>Key</th>
            <th>Label</th>
            <th>Effective</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @values.each do |v| %>
            <tr>
              <td><%= v.position %></td>
              <td class="font-mono"><%= v.code.presence || "—" %></td>
              <td><%= v.label %></td>
              <td class="text-xs"><%= v.effective_from&.to_s || "—" %> → <%= v.effective_to&.to_s || "—" %></td>
              <td class="text-right"><%= link_to "Show", system_reference_value_path(v), class: "link link-primary" %></td>
            </tr>
          <% end %>
          <% if @values.empty? %>
            <tr><td colspan="6" class="text-center opacity-70">No values.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
